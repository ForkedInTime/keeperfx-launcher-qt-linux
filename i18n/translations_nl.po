msgstr "Verwijder KeeperFX"

msgctxt "InstallKfxDialog|MessageBox Text"
msgid ""
"Do you want to uninstall KeeperFX?\n"
"\n"
"This will remove any leftover files."
msgstr ""
"Wil je KeeperFX verwijderen?\n"
"\n"
"Dit verwijdert ook alle achtergebleven bestanden."

