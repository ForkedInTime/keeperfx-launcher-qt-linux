msgid "Select Directory containing Dungeon Keeper files"
msgstr "Sélectionner le répertoire contenant les fichiers de Dungeon Keeper"

msgctxt "CopyDkFilesDialog|MessageBox Title"
msgid "Original DK files not found"
msgstr "Fichiers originaux de DK introuvables"

msgctxt "CopyDkFilesDialog|MessageBox Text"
msgid ""
"The chosen directory does not contain all of the required files. Please "
"select an original Dungeon Keeper installation."
msgstr ""
"Le répertoire choisi ne contient pas tous les fichiers nécessaires. Merci de "
"sélectionner un emplacement d'installation du jeu d'origine Dungeon Keeper."

msgctxt "CopyDkFilesDialog|MessageBox Title"
msgid "Select a directory"
msgstr "Choisir un répertoire"

msgctxt "CopyDkFilesDialog|MessageBox Text"
msgid "Please select an original Dungeon Keeper installation location."
msgstr ""
"Merci de sélectionner un emplacement d'installation du jeu d'origine Dungeon "
